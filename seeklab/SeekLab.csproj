<Project Sdk="Microsoft.NET.Sdk">

  <!-- SEEKLAB - the AutoSeek/AutoThrust testbed.
       ======================================================================================
       WHY THIS EXISTS. AutoSeek and AutoThrust are control loops, and a control loop is tuned
       by iteration: change a gain, watch the response, change it again. Living in BetterExperience
       they could only be changed by rebuilding a plugin and RESTARTING THE GAME, then walking the
       character back into position - minutes per iteration, and every restart resets the very
       state being debugged. That cost, not the difficulty of the control problem, is what has
       dominated this work.

       So the code lives here instead: a ScriptEngine assembly in BepInEx\scripts, reloadable with
       F6 or a POST to the probe, with no restart and no repositioning. BetterExperience's own
       copies stand down while this is loaded (SeekLabHandoff), so there is exactly one owner of
       the pelvis at any time.

       This is a TEMPORARY HOME. The two feature files are byte-identical copies of BE's, changed
       only where the move forces it, so merging back is a small reviewable diff rather than a
       rewrite. See README.md for the merge-back procedure.
       ====================================================================================== -->

  <PropertyGroup>
    <AssemblyName>SeekLab</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <!-- net472 to match BetterExperience exactly: the copied sources compile against the same
         surface here as they will after merge-back, so "it built in the lab" means something. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace />
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The PDB travels to BepInEx\scripts with the DLL or every stack trace loses line numbers,
         which is most of the value of a fast iteration loop. -->
    <DebugType>portable</DebugType>
    <!-- BUILD OUTSIDE BepInEx\plugins. That tree is scanned RECURSIVELY, so a bin\Release here
         would be loaded as a SECOND copy of this assembly alongside the hot-reload copy in
         BepInEx\scripts - two seekers commanding one pelvis, which is the exact failure this
         whole exercise exists to avoid. Same reason DevProbe builds to _build. -->
    <BaseOutputPath>F:\Games\AAA\SMA_23.1_HomeworkTestbed\_build\SeekLab\</BaseOutputPath>
    <BaseIntermediateOutputPath>F:\Games\AAA\SMA_23.1_HomeworkTestbed\_build\SeekLab\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

